{
	"$schema": "https://raw.githubusercontent.com/BetterNCM/BetterNCM-Plugins/refs/heads/master/manifest-schema.json",
	"manifest_version": 1,
	"name": "日语歌词振假名 Plus",
	"slug": "jp-furigana-plus",
	"version": "1.6.3",
	"author": "CarrotLouis（基于 leleawa/jp-furigana）",
	"author_link": "https://github.com/CarrotLouis/jp-furigana/tree/standalone",
	"description": "日语歌词振假名：网易云音译、离线词典、外部网站；支持人工纠音、本地歌词管理、代理与可选透明桌面注音",
	"preview": "preview.jpg",
	"type": "extension",
	"betterncm_version": ">=1.3.4",
	"ncm3-compatible": true,
	"requirements": [
		"RefinedNowPlayingNext"
	],
	"injects": {
		"Main": [
			{
				"file": "kuromoji.js"
			},
			{
				"file": "furigana.js"
			},
			{
				"file": "external-core.js"
			},
			{
				"file": "user-edits.js"
			},
			{
				"file": "external.js"
			},
			{
				"file": "editor.js"
			},
			{
				"file": "rnp-settings.js"
			},
			{
				"file": "desktop.js"
			},
			{
				"file": "source-dialog.js"
			},
			{
				"file": "main.js"
			}
		]
	},
	"fork_of": "jp-furigana",
	"require_restart": true,
	"ncm-version-req": "> 3.1.11"
}
