{
  "$schema": "https://raw.githubusercontent.com/BetterNCM/BetterNCM-Plugins/refs/heads/master/manifest-schema.json",
  "manifest_version": 1,
  "name": "RNP Video Background",
  "slug": "rnp-video-background",
  "version": "0.2.2",
  "betterncm_version": ">=1.0.0",
  "author": "wmgqdavid",
  "author_link": "https://github.com/wmgqdavid",
  "description": "为 RefinedNowPlaying Next 提供本地视频背景、可选声音及自动兼容转换。",
  "preview": "preview.svg",
  "type": "extension",
  "require_restart": false,
  "requirements": [
    "RefinedNowPlayingNext"
  ],
  "loadAfter": [
    "RefinedNowPlayingNext"
  ],
  "ncm-version-req": "> 3.1.11",
  "ncm3-compatible": true,
  "injects": {
    "Main": [
      {
        "file": "main.js"
      }
    ]
  }
}
