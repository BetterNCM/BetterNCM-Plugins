{
  "manifest_version": 1,
  "name": "BetterDownload",
  "slug": "ncm-better-download",
  "version": "0.4.2",
  "author": "XIAOMING6680",
  "description": "自动解锁下载的 VIP 歌曲，保留原音质，内嵌封面与歌曲信息。",
  "betterncm_version": ">=1.3.4",
  "ncm-version-req": ">=3.0.0",
  "ncm3-compatible": true,
  "type": "extension",
  "require_restart": true,
  "preview": "preview.jpg",
  "injects": {
    "Main": [
      {
        "file": "download-hook.js"
      },
      {
        "file": "progress-card.js"
      },
      {
        "file": "main.js"
      }
    ]
  },
  "author_link": "https://github.com/xiaoming6680"
}
