{
    "manifest_version": 1,
    "name": "HideLyric",
    "slug": "HideLyric",
    "version": "1.1.0",
    "author": "Lzhyrifx",
    "author_links": ["https://github.com/Lzhyrifx"],
    "description": "自动隐藏网易云无意义桌面歌词(如纯音乐请欣赏,暂无歌词等)",
    "betterncm_version": ">=1.0.0",
    "type": "extension",
    "ncm3-compatible": true,
    "preview": "preview.png",
    "injects": {
        "Main": [ 
            {
                "file": "main.js"
            }
        ]
    },
    "loadAfter":["liblyric"],
    "requirements": ["liblyric"]
}